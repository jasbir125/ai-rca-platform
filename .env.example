# Copy to .env and adjust for your machine. Every value here has a safe local default.

# ---- Postgres / pgvector ----
# Deliberately NOT 5432: several dev machines (including the one this was built on)
# already run a native/Homebrew Postgres on 5432, which silently wins the connection
# over the docker-compose container of the same name on "localhost". 5433 avoids that.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=rca_platform
POSTGRES_USER=rca
POSTGRES_PASSWORD=rca_local_dev_only

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- AI provider ----
# OLLAMA (default, local) or BEDROCK (requires AWS credentials)
AI_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:latest
EMBEDDING_MODEL=nomic-embed-text

# Only used when AI_PROVIDER=BEDROCK
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ---- Observability backends ----
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
OTEL_COLLECTOR_URL=http://localhost:4318

# ---- Git evidence ----
# LOCAL reads real git history from the local services/ repo (default for this POC).
# GITLAB talks to a real GitLab instance via REST.
GIT_PROVIDER=LOCAL
GIT_LOCAL_REPO_PATH=../services/order-service
GITLAB_BASE_URL=
GITLAB_TOKEN=

# ---- Kubernetes ----
# Left empty locally -> Kubernetes Agent reports "unavailable" and degrades gracefully.
KUBERNETES_ENABLED=false
KUBECONFIG_PATH=

# ---- AWS (CloudWatch tool, Bedrock, Terraform outputs) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Optional integrations (all no-op/log-only until configured) ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Sample microservices ----
ORDER_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
API_GATEWAY_PORT=8080

# Order Service -> Payment Service call timeout (ms). The demo "bad deploy"
# changes this from 3000 to 500 via a real git commit + redeploy.
PAYMENT_CALL_TIMEOUT_MS=3000

# Payment Service simulated processing latency (ms) and failure controls,
# overridable live via the incident simulator's /admin/chaos endpoint.
PAYMENT_LATENCY_MS=700
PAYMENT_FAILURE_RATE=0.0

# ---- RCA platform services ----
RCA_API_PORT=8090
RCA_ORCHESTRATOR_PORT=8091
JWT_ISSUER_URI=

# ---- UI ----
VITE_RCA_API_BASE_URL=http://localhost:8090